{
  "name": "desk-helper",
  "version": "0.3.6",
  "description": "WhatsApp, Telegram, not defteri, dosya gezgini ve favori programları tek pencerede toplayan masaüstü uygulaması",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "bump": "node scripts/bump.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.rbnbilisim.deskhelper",
    "productName": "Desk Helper",
    "copyright": "© 2026 rbnbilisim",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "CHANGELOG.md",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/{src,doc,vendor}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Desk Helper",
      "menuCategory": "rbnbilisim",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Desk Helper ${version}",
      "artifactName": "DeskHelper-Setup-${version}.exe",
      "language": "1055"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RbnCore",
        "repo": "desk-helper",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "rbnbilisim",
    "email": "rbnbilisim@gmail.com"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RbnCore/desk-helper.git"
  }
}
