{
  "name": "desk-helper",
  "version": "0.2.7",
  "description": "WhatsApp, Telegram, not defteri, dosya gezgini ve favori programları tek pencerede toplayan masaüstü uygulaması",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "bump": "node scripts/bump.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.rbnbilisim.deskhelper",
    "productName": "Desk Helper",
    "copyright": "© 2026 rbnbilisim",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/{src,doc,vendor}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Desk Helper",
      "menuCategory": "rbnbilisim",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Desk Helper ${version}",
      "artifactName": "DeskHelper-Setup-${version}.exe",
      "language": "1055"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "rbnbilisim",
    "email": "rbnbilisim@gmail.com"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  }
}
